[Desktop Entry]
Type=Application
Version=1.0
Name=LumenCode
GenericName=Structural Code Explorer
Comment=Inspect project structure and source snippets
Exec=lumencode %f
Icon=app.lumencode.LumenCode
Terminal=false
Categories=Development;IDE;Qt;
StartupNotify=true
MimeType=inode/directory;text/plain;text/x-chdr;text/x-csrc;text/x-c++hdr;text/x-c++src;text/x-java;text/x-python;text/x-php;text/x-rust;text/x-javascript;text/x-typescript;text/css;text/html;application/json;text/x-qml;text/x-swift;text/x-csharp;application/javascript;application/x-typescript;application/xml;text/xml;
