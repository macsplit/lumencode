<Window x:Class="LumenCode.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:LumenCode.Windows">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
   <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,16,0,8"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenShortcut"/>
   <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindShortcut"/>
   <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RefreshShortcut"/>
   <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackShortcut"/>
   <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardShortcut"/>
  </Grid.KeyboardAccelerators>
  <Grid Padding="16,10" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" Click="BackClick" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back (Alt+Left)" IsEnabled="False"/>
    <Button x:Name="ForwardButton" Content="&#xE72A;" FontFamily="Segoe Fluent Icons" Click="ForwardClick" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward (Alt+Right)" IsEnabled="False"/>
    <Button Content="Open folder…" Click="OpenClick" ToolTipService.ToolTip="Open folder (Ctrl+O)"/>
    <Button Content="Refresh" Click="RefreshClick" ToolTipService.ToolTip="Refresh project (Ctrl+R)"/>
   </StackPanel>
   <TextBlock x:Name="ProjectTitle" Grid.Column="1" Text="LumenCode" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
    <Button Content="Open in editor" Click="EditorClick"/>
    <Button Content="Show in Explorer" Click="ExplorerClick"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="WorkspaceGrid" Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition x:Name="ContentRow" Height="2*" MinHeight="220"/><RowDefinition Height="6"/><RowDefinition x:Name="PreviewRow" Height="*" MinHeight="140"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="FilesColumn" Width="290" MinWidth="220"/><ColumnDefinition Width="6"/><ColumnDefinition x:Name="OverviewColumn" Width="*" MinWidth="260"/><ColumnDefinition Width="6"/><ColumnDefinition x:Name="DetailColumn" Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Padding="12" RowSpacing="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Project" FontSize="20" FontWeight="SemiBold"/>
    <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Search files and symbols" TextChanged="SearchChanged" AutomationProperties.Name="Search files and symbols"/>
    <TextBlock x:Name="IndexStatus" Grid.Row="2" Text="Choose a folder to start exploring." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TreeView x:Name="Files" Grid.Row="3" SelectionMode="Single" Expanding="FolderExpanding" ItemInvoked="FileInvoked" AutomationProperties.Name="Project files"/>
    <ListView x:Name="SearchResults" Grid.Row="3" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="SearchInvoked" SelectionMode="Single" AutomationProperties.Name="Search results">
     <ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="2" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Grid>
   <local:PaneSplitter x:Name="FilesDivider" Grid.Column="1" IsVertical="True" Dragged="FilesSplit" AutomationProperties.Name="Resize project pane"/>
   <Grid Grid.Column="2" Padding="16" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="FileTitle" Text="Explore your code" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock x:Name="AnalysisSummary" Grid.Row="1" Text="Open a project and select a file to see its structure, relationships and source." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <ListView x:Name="Overview" Grid.Row="2" IsItemClickEnabled="True" ItemClick="OverviewInvoked" SelectionMode="Single" AutomationProperties.Name="File analysis">
     <ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,7"><TextBlock Text="{Binding Section}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="3" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Grid>
   <local:PaneSplitter x:Name="OverviewDivider" Grid.Column="3" IsVertical="True" Dragged="OverviewSplit" AutomationProperties.Name="Resize overview pane"/>
   <ScrollViewer Grid.Column="4" Padding="16" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8">
     <TextBlock x:Name="DetailTitle" Text="Details" FontSize="22" FontWeight="SemiBold" IsTextSelectionEnabled="True"/>
     <TextBlock x:Name="DetailSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True"/>
     <TextBlock x:Name="Signature" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True"/>
     <StackPanel x:Name="DetailSections"/>
    </StackPanel>
   </ScrollViewer>
   <local:PaneSplitter x:Name="PreviewDivider" Grid.Row="1" Grid.ColumnSpan="5" Dragged="PreviewSplit" AutomationProperties.Name="Resize code preview"/>
   <Grid Grid.Row="2" Grid.ColumnSpan="5" Padding="12,8" RowSpacing="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PreviewTitle" Text="Source preview" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
      <StackPanel x:Name="PreviewNavigation" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
       <Button x:Name="PreviousPreview" Content="Previous" Padding="10,2" Click="PreviousPreviewClick" AutomationProperties.Name="Previous source page"/>
       <TextBlock x:Name="PreviewPosition" VerticalAlignment="Center" FontSize="12"/>
       <Button x:Name="NextPreview" Content="Next" Padding="10,2" Click="NextPreviewClick" AutomationProperties.Name="Next source page"/>
      </StackPanel>
      <Button Content="Copy" Padding="10,2" Click="CopyClick" AutomationProperties.Name="Copy source preview" ToolTipService.ToolTip="Copy the full loaded source preview"/>
     </StackPanel>
    </Grid>
    <RichEditBox x:Name="Code" Grid.Row="1" IsReadOnly="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="NoWrap" AutomationProperties.Name="Source preview"/>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Padding="16,6" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False"/>
   <TextBlock x:Name="Status" Grid.Column="1" Text="Ready" FontSize="12" MaxLines="2" IsTextSelectionEnabled="True"/>
  </Grid>
 </Grid>
</Window>
