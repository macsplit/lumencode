{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/lumencode/tools/agent/hooks/lumencode_hook.py pre",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /path/to/lumencode/tools/agent/hooks/lumencode_hook.py post",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
